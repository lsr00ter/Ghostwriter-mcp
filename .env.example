# Copy to .env and fill in your values.

# Required: Ghostwriter GraphQL endpoint
# (GHOSTWRITER_URL is also accepted as an alias)
GHOSTWRITER_GRAPHQL_URL=https://ghostwriter.example.local/v1/graphql

# Recommended: bearer token for authentication
GHOSTWRITER_API_TOKEN=your_api_token_here

# Optional overrides
# GHOSTWRITER_REQUEST_TIMEOUT=10
# GHOSTWRITER_DEFAULT_PROJECT_TYPE_ID=1
# GHOSTWRITER_DEFAULT_SEVERITY_ID=1
# GHOSTWRITER_PAGINATION_LIMIT=50

# Last resort only: disable TLS certificate verification for a Ghostwriter host
# whose certificate is untrusted or has no usable subjectAltName (for example a
# self-signed cert served over a bare IP address). Prefer putting the CA in your
# system trust store. Setting this to 1 disables server authentication and logs
# a warning on every client start.
# GHOSTWRITER_TLS_INSECURE=0
